  <!-- ImageSharp 3.2.0 fails every Release build without a Six Labors licence key. The 3.1.12 advisories are in the TIFF
       codecs, HistogramEqualization and the ICC CLUT parser: PhotoService decodes only JPEG/PNG/WebP and never parses ICC
       (guard: PhotoUploadGuardTests). Remove this block when moving to a licensed 3.2+. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
