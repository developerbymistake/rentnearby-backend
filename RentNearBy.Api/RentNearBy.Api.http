@RentNearBy.Api_HostAddress = http://localhost:5292

GET {{RentNearBy.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

@baseUrl = http://localhost:5000
@adminToken = <admin-jwt>

GET {{baseUrl}}/api/v1/config/app-version?platform=android&build=52
Accept: application/json

###

GET {{baseUrl}}/api/v1/admin/app-version
Authorization: Bearer {{adminToken}}
Accept: application/json

###

PUT {{baseUrl}}/api/v1/admin/app-version/android
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isEnabled": true,
  "minBuildNumber": 52,
  "minVersionName": "1.0.1",
  "latestBuildNumber": 53,
  "latestVersionName": "1.0.2",
  "storeUrl": "https://play.google.com/store/apps/details?id=com.rentnearby.rentnearby",
  "message": "",
  "forceCacheMaxAgeHours": 168,
  "reason": "Payment fix in build 53"
}

###

@userToken = <user-jwt>
@cityId = <city-guid>
@cityKey = 502141
@tripId = <trip-guid>

GET {{baseUrl}}/api/v1/trips/cities?page=1&pageSize=100
Authorization: Bearer {{userToken}}
Accept: application/json

###

GET {{baseUrl}}/api/v1/trips/cities/version
Authorization: Bearer {{userToken}}
Accept: application/json

###

# Map pack of one state; take stateId and version (path) from packs[] of /trips/cities/version.
@stateId = <state-guid>
@packVersion = <16-hex-version>
GET {{baseUrl}}/api/v1/trips/map-packs/{{stateId}}/{{packVersion}}
Authorization: Bearer {{userToken}}
Accept-Encoding: gzip

###

GET {{baseUrl}}/api/v1/config/map-discovery
Accept: application/json

###

GET {{baseUrl}}/api/v1/admin/map-discovery
Authorization: Bearer {{adminToken}}
Accept: application/json

###

# New trip map off (old map rendering) without an app build; isEnabled true switches it back on.
PUT {{baseUrl}}/api/v1/admin/map-discovery
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isEnabled": false,
  "reason": "switch back to the old map"
}

###

GET {{baseUrl}}/api/v1/trips/cities/{{cityKey}}/spots?pageSize=20
Authorization: Bearer {{userToken}}
Accept: application/json

###

POST {{baseUrl}}/api/v1/trips/plan
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "cityKey": {{cityKey}},
  "mode": "auto",
  "spots": [
    { "id": "osm:W1001", "name": "Mall Road", "latitude": 29.3919, "longitude": 79.4542, "category": "attraction", "visitMinutes": 90 },
    { "id": "osm:N1002", "name": "Naina Devi Temple", "latitude": 29.3925, "longitude": 79.4528, "category": "temple", "visitMinutes": 60 },
    { "id": "wiki:12345", "name": "Snow View", "latitude": 29.3990, "longitude": 79.4610, "category": "viewpoint", "visitMinutes": 120 }
  ]
}

###

POST {{baseUrl}}/api/v1/trips/plan
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "cityKey": {{cityKey}},
  "mode": "recalculate",
  "days": [
    { "day": 1, "spots": [
      { "id": "osm:W1001", "name": "Mall Road", "latitude": 29.3919, "longitude": 79.4542, "category": "attraction", "visitMinutes": 90 },
      { "id": "wiki:12345", "name": "Snow View", "latitude": 29.3990, "longitude": 79.4610, "category": "viewpoint", "visitMinutes": 120 }
    ] }
  ]
}

###

GET {{baseUrl}}/api/v1/trips?page=1&pageSize=20
Authorization: Bearer {{userToken}}
Accept: application/json

###

POST {{baseUrl}}/api/v1/trips
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "status": "Draft",
  "plan": {
    "version": 2,
    "cityKey": {{cityKey}},
    "cityName": "Nainital",
    "days": [
      { "day": 1, "spots": [
        { "id": "osm:W1001", "name": "Mall Road", "latitude": 29.3919, "longitude": 79.4542, "category": "attraction", "visitMinutes": 90 }
      ] }
    ],
    "settings": { "dayLimitMinutes": 450 }
  }
}

###

GET {{baseUrl}}/api/v1/trips/{{tripId}}
Authorization: Bearer {{userToken}}
Accept: application/json

###

PUT {{baseUrl}}/api/v1/trips/{{tripId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title": "Nainital weekend",
  "status": "Planned",
  "plan": {
    "version": 2,
    "cityKey": {{cityKey}},
    "cityName": "Nainital",
    "days": [
      { "day": 1, "spots": [
        { "id": "osm:W1001", "name": "Mall Road", "latitude": 29.3919, "longitude": 79.4542, "category": "attraction", "visitMinutes": 90 }
      ], "taxi": { "taxiId": "<taxi-guid>", "name": "Ramesh", "fare": 1800 } }
    ],
    "settings": { "dayLimitMinutes": 450 }
  }
}

###

# Complete my plan: open Taxi and Stay parts become skipped (idempotent)
POST {{baseUrl}}/api/v1/trips/{{tripId}}/complete-plan
Authorization: Bearer {{userToken}}

###

DELETE {{baseUrl}}/api/v1/trips/{{tripId}}
Authorization: Bearer {{userToken}}

###

GET {{baseUrl}}/api/v1/taxis/browse?districtId=<district-guid>&cityId={{cityId}}&cityOnly=true&page=1&pageSize=20
Authorization: Bearer {{userToken}}
Accept: application/json

###

# ============================================================================
# Taxi request system. One example per route of
# F:/Dhasu/TaxiRequest_resume/CONTRACT_TAXI_REQUEST.md (sections 3, 5, 6, 7, 11).
# Bodies are the contract samples in F:/Dhasu/TaxiRequest_resume/contract_samples/.
# Gated routes answer 403 TripExecutionDisabled while the master switch is off
# (contract section 1). The ids below are the contract sample ids, replace them.
# These are examples only: none of them was sent in the run that wrote them.
# ============================================================================

@driverToken = <taxi-driver-jwt>
@requestId = 3f9a6c2d-1b7e-4f0a-8c55-2e7d9b4a6101
@offerId = a1b2c3d4-0001-4a00-8000-000000000001
@bookingId = <booking-guid>
@adminRequestId = 3f9a6c2d-1b7e-4f0a-8c55-2e7d9b4a6101
@taxiId = <taxi-listing-guid>

### Trip name (contract section 3): POST /trips with the new optional "name" (1 to 60 characters)

POST {{baseUrl}}/api/v1/trips
Authorization: Bearer {{userToken}}
Content-Type: application/json

{ "name": "Uttarakhand Hills Trip", "status": "Draft", "clientTripId": "0c3d6f1a-2b4e-4d6f-8a1c-5e7f9b2d4c10", "plan": { "version": 6 } }

### Invite GUID (contract section 3): owner only, 404 NotFound for anyone else, not gated

GET {{baseUrl}}/api/v1/trips/{{tripId}}/invite
Authorization: Bearer {{userToken}}
Accept: application/json

### T1 pickup places (open)

GET {{baseUrl}}/api/v1/trips/{{tripId}}/taxi-request/pickup-places
Authorization: Bearer {{userToken}}
Accept: application/json

### T2 create taxi request (gated), 201 with state Open

POST {{baseUrl}}/api/v1/trips/{{tripId}}/taxi-request
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "clientRequestId": "9d2f7c11-3a5b-4e8d-b0c6-1f4a7e9d2b55",
  "pickup": { "on": true, "cityKey": 6377270 },
  "sightseeing": { "on": true, "days": [1, 2, 4] },
  "drop": { "on": true, "sameAsPickup": true, "cityKey": null },
  "seats": 4,
  "dayStats": [
    { "day": 1, "km": 25, "minutes": 370 },
    { "day": 2, "km": 30, "minutes": 560 },
    { "day": 3, "km": 40, "minutes": 300 },
    { "day": 4, "km": 18, "minutes": 230 }
  ]
}

### T3 the trip taxi request (active, else latest); data is null when the trip never had one (open)

GET {{baseUrl}}/api/v1/trips/{{tripId}}/taxi-request
Authorization: Bearer {{userToken}}
Accept: application/json

### T4 one taxi request (open)

GET {{baseUrl}}/api/v1/taxi-requests/{{requestId}}
Authorization: Bearer {{userToken}}
Accept: application/json

### T5 cancel (open). A Booked request needs "chip" (400 ReasonRequired otherwise)

POST {{baseUrl}}/api/v1/taxi-requests/{{requestId}}/cancel
Authorization: Bearer {{userToken}}
Content-Type: application/json

{ "reason": "TravellerCancelled", "chip": null }

### T6 ask more drivers (gated)

POST {{baseUrl}}/api/v1/taxi-requests/{{requestId}}/ask-more
Authorization: Bearer {{userToken}}

### T7 select a driver who accepted (gated)

POST {{baseUrl}}/api/v1/taxi-requests/{{requestId}}/offers/{{offerId}}/select
Authorization: Bearer {{userToken}}

### T8 not agreed with the selected driver (open)

POST {{baseUrl}}/api/v1/taxi-requests/{{requestId}}/offers/{{offerId}}/not-agreed
Authorization: Bearer {{userToken}}

### T9 end the trip early (open)

POST {{baseUrl}}/api/v1/taxi-requests/{{requestId}}/end
Authorization: Bearer {{userToken}}

### T10 rate the driver, once, only after Completed (open)

POST {{baseUrl}}/api/v1/taxi-requests/{{requestId}}/rating
Authorization: Bearer {{userToken}}
Content-Type: application/json

{ "stars": 5 }

### D1 driver offers, first page; next pages use ?cursor= (open, policy CanListTaxis)

GET {{baseUrl}}/api/v1/taxi-requests/driver/offers
Authorization: Bearer {{driverToken}}
Accept: application/json

### D2 one offer, with the trip block (open)

GET {{baseUrl}}/api/v1/taxi-requests/driver/offers/{{offerId}}
Authorization: Bearer {{driverToken}}
Accept: application/json

### D3 accept a ringing offer (gated)

POST {{baseUrl}}/api/v1/taxi-requests/driver/offers/{{offerId}}/accept
Authorization: Bearer {{driverToken}}

### D4 decline (open), chip is optional

POST {{baseUrl}}/api/v1/taxi-requests/driver/offers/{{offerId}}/decline
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{ "chip": null }

### D5 confirm after the traveller selected this driver (gated, 15 minute window)

POST {{baseUrl}}/api/v1/taxi-requests/driver/offers/{{offerId}}/confirm
Authorization: Bearer {{driverToken}}

### D6 withdraw (open), chip required

POST {{baseUrl}}/api/v1/taxi-requests/driver/offers/{{offerId}}/withdraw
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{ "chip": "VehicleIssue" }

### D7 end a booking (open)

POST {{baseUrl}}/api/v1/taxi-requests/driver/bookings/{{bookingId}}/end
Authorization: Bearer {{driverToken}}

### D8 bookings in a date range (open)

GET {{baseUrl}}/api/v1/taxi-requests/driver/bookings?from=2026-12-01&to=2026-12-31
Authorization: Bearer {{driverToken}}
Accept: application/json

### D9 rating summary (open)

GET {{baseUrl}}/api/v1/taxi-requests/driver/rating
Authorization: Bearer {{driverToken}}
Accept: application/json

### D10 readiness (open)

GET {{baseUrl}}/api/v1/taxi-requests/driver/readiness
Authorization: Bearer {{driverToken}}
Accept: application/json

### D11 report the phone state (open). ringTested, notificationsOn and ringChannelOn all true reset missed rings

PUT {{baseUrl}}/api/v1/taxi-requests/driver/readiness
Authorization: Bearer {{driverToken}}
Content-Type: application/json

{ "appBuild": 69, "notificationsOn": true, "ringChannelOn": true, "batteryUnrestricted": false, "manufacturer": "Xiaomi", "androidSdk": 34, "ringTested": false }

### D12 send a test ring to the caller phone, 204 (open, 6 per hour)

POST {{baseUrl}}/api/v1/taxi-requests/driver/test-ring
Authorization: Bearer {{driverToken}}

### Ring ack (contract section 7): anonymous, no Authorization header, 204; a wrong token is 404 OfferNotFound

POST {{baseUrl}}/api/v1/taxi-requests/offers/{{offerId}}/ack
Content-Type: application/json

{
  "ackToken": "Qk9fY2xhdWRlX3NhbXBsZQ",
  "receivedAt": "2026-12-10T09:41:09Z",
  "shown": true,
  "late": false,
  "notificationsOn": true,
  "ringChannelOn": true,
  "manufacturer": "Xiaomi",
  "androidSdk": 34,
  "appBuild": 69
}

### AD1 admin list of taxi requests

GET {{baseUrl}}/api/v1/admin/taxi-requests?state=active&size=20
Authorization: Bearer {{adminToken}}
Accept: application/json

### AD2 admin request detail

GET {{baseUrl}}/api/v1/admin/taxi-requests/{{adminRequestId}}
Authorization: Bearer {{adminToken}}
Accept: application/json

### AD3 admin cancel, note 1 to 300 characters

POST {{baseUrl}}/api/v1/admin/taxi-requests/{{adminRequestId}}/cancel
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "note": "Stuck in finding" }

### AD4 admin list of taxi bookings

GET {{baseUrl}}/api/v1/admin/taxi-bookings?state=active&size=20
Authorization: Bearer {{adminToken}}
Accept: application/json

### AD5 admin health numbers (the only place for the taxi request dashboard numbers)

GET {{baseUrl}}/api/v1/admin/taxi-requests/health
Authorization: Bearer {{adminToken}}
Accept: application/json

### AD6 existing admin taxi detail, with rating and ring fields and resolved route cities

GET {{baseUrl}}/api/v1/admin/taxis/{{taxiId}}
Authorization: Bearer {{adminToken}}
Accept: application/json

### Delete account: 204 when nothing is active; else 409
### { "error": { "type": "AccountHasActiveItems", "message": "Take your listing offline first." },
###   "data": { "reasons": [ { "code": "LiveListing", "message": "Take your listing offline first." } ] } }

DELETE {{baseUrl}}/api/v1/account
Authorization: Bearer {{userToken}}

### Admin deleted accounts (keyset; search with digits = phone; then cursor=<nextCursor>)

@deletedAccountId = <deleted-account-record-guid>
GET {{baseUrl}}/api/v1/admin/deleted-accounts?search=98765&pageSize=20
Authorization: Bearer {{adminToken}}
Accept: application/json

### Admin deleted account detail (licence decrypted here only; audit log deleted_account.admin.viewed)

GET {{baseUrl}}/api/v1/admin/deleted-accounts/{{deletedAccountId}}
Authorization: Bearer {{adminToken}}
Accept: application/json
