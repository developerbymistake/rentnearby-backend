@RentNearBy.Api_HostAddress = http://localhost:5292

GET {{RentNearBy.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

@baseUrl = http://localhost:5000
@adminToken = <admin-jwt>

GET {{baseUrl}}/api/v1/config/app-version?platform=android&build=52
Accept: application/json

###

GET {{baseUrl}}/api/v1/admin/app-version
Authorization: Bearer {{adminToken}}
Accept: application/json

###

PUT {{baseUrl}}/api/v1/admin/app-version/android
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isEnabled": true,
  "minBuildNumber": 52,
  "minVersionName": "1.0.1",
  "latestBuildNumber": 53,
  "latestVersionName": "1.0.2",
  "storeUrl": "https://play.google.com/store/apps/details?id=com.rentnearby.rentnearby",
  "message": "",
  "forceCacheMaxAgeHours": 168,
  "reason": "Payment fix in build 53"
}

###

@userToken = <user-jwt>
@cityId = <city-guid>
@tripId = <trip-guid>

GET {{baseUrl}}/api/v1/trips/cities/{{cityId}}/spots?pageSize=20
Authorization: Bearer {{userToken}}
Accept: application/json

###

POST {{baseUrl}}/api/v1/trips/plan
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "cityId": "{{cityId}}",
  "mode": "auto",
  "spots": [
    { "id": "osm:W1001", "name": "Mall Road", "latitude": 29.3919, "longitude": 79.4542, "category": "attraction", "visitMinutes": 90 },
    { "id": "osm:N1002", "name": "Naina Devi Temple", "latitude": 29.3925, "longitude": 79.4528, "category": "temple", "visitMinutes": 60 },
    { "id": "wiki:12345", "name": "Snow View", "latitude": 29.3990, "longitude": 79.4610, "category": "viewpoint", "visitMinutes": 120 }
  ]
}

###

POST {{baseUrl}}/api/v1/trips/plan
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "cityId": "{{cityId}}",
  "mode": "recalculate",
  "days": [
    { "day": 1, "spots": [
      { "id": "osm:W1001", "name": "Mall Road", "latitude": 29.3919, "longitude": 79.4542, "category": "attraction", "visitMinutes": 90 },
      { "id": "wiki:12345", "name": "Snow View", "latitude": 29.3990, "longitude": 79.4610, "category": "viewpoint", "visitMinutes": 120 }
    ] }
  ]
}

###

GET {{baseUrl}}/api/v1/trips?page=1&pageSize=20
Authorization: Bearer {{userToken}}
Accept: application/json

###

POST {{baseUrl}}/api/v1/trips
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "status": "Draft",
  "plan": {
    "version": 1,
    "cityId": "{{cityId}}",
    "districtId": "<district-guid>",
    "cityName": "Nainital",
    "days": [
      { "day": 1, "spots": [
        { "id": "osm:W1001", "name": "Mall Road", "latitude": 29.3919, "longitude": 79.4542, "category": "attraction", "visitMinutes": 90 }
      ] }
    ],
    "settings": { "dayLimitMinutes": 450 }
  }
}

###

GET {{baseUrl}}/api/v1/trips/{{tripId}}
Authorization: Bearer {{userToken}}
Accept: application/json

###

PUT {{baseUrl}}/api/v1/trips/{{tripId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title": "Nainital weekend",
  "status": "Planned",
  "plan": {
    "version": 1,
    "cityId": "{{cityId}}",
    "districtId": "<district-guid>",
    "cityName": "Nainital",
    "days": [
      { "day": 1, "spots": [
        { "id": "osm:W1001", "name": "Mall Road", "latitude": 29.3919, "longitude": 79.4542, "category": "attraction", "visitMinutes": 90 }
      ], "taxi": { "taxiId": "<taxi-guid>", "name": "Ramesh", "fare": 1800 } }
    ],
    "settings": { "dayLimitMinutes": 450 }
  }
}

###

DELETE {{baseUrl}}/api/v1/trips/{{tripId}}
Authorization: Bearer {{userToken}}

###

GET {{baseUrl}}/api/v1/taxis/browse?districtId=<district-guid>&cityId={{cityId}}&cityOnly=true&page=1&pageSize=20
Authorization: Bearer {{userToken}}
Accept: application/json

###
